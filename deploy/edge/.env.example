# Image published by GitHub Actions on push to main
DIGI_DX_EDGE_IMAGE=ghcr.io/mpmbq2/digi-dx-edge:latest

# Cloud Gateway WebSocket URL (optional if pairing with remote gateway)
DIGI_DX_CLOUD_URL=ws://127.0.0.1:8795

# Optional persistent station ID override
# DIGI_DX_STATION_ID=

# Minimum idle seconds before auto-updater restarts the container (default: 1800 = 30 minutes)
DIGI_DX_MIN_IDLE_SECONDS=1800
