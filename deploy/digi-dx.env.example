# Digi-Dx v2 Daemon Environment Configuration
# Placed at /etc/digi-dx/digi-dx.env (mode 0600) on Linux systemd hosts.

# HTTP/WebSocket bind host and port
DIGI_DX_BIND=0.0.0.0
DIGI_DX_PORT=8788

# Persistent SQLite database directory
DIGI_DX_DATA_DIR=/var/lib/digi-dx

# Optional static bearer token protecting mutating LAN commands (POST /api/v1/commands & WS).
# Uncomment and set a strong secret on shared/untrusted LANs:
# DIGI_DX_AUTH_TOKEN=replace-with-random-secret

# Optional binary path overrides
# DIGI_DX_RIGCTL_PATH=/usr/bin/rigctl
# DIGI_DX_RIGCTLD_PATH=/usr/bin/rigctld
# DIGI_DX_JT9_PATH=/usr/local/bin/jt9

# Future GCP seams (disabled in MVP)
DIGI_DX_GCP_TELEMETRY_ENABLED=false
DIGI_DX_GCP_BRIDGE_ENABLED=false

# Outbox retention bounds (protects Raspberry Pi SD cards)
DIGI_DX_OUTBOX_MAX_ROWS=50000
DIGI_DX_OUTBOX_RETENTION_DAYS=14

# Logging level
RUST_LOG=info,digi_dx=info
