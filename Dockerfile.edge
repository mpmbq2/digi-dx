# syntax=docker/dockerfile:1
FROM node:20-bookworm AS engine-builder
WORKDIR /app
COPY scripts/engine-versions.env scripts/install-engine.sh ./scripts/
RUN bash scripts/install-engine.sh && rm -rf /app/vendor/engine/build /app/vendor/engine/cache

FROM node:20-bookworm-slim AS app-builder
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci
COPY core ./core
COPY src ./src
RUN npm run build

FROM node:20-bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 \
    libhamlib-utils \
    libasound2 \
    libsndfile1 \
    libfftw3-single3 \
    libqt5core5a \
    libgfortran5 \
    libgomp1 \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=engine-builder /usr/local/lib/librtaudio* /usr/local/lib/
COPY --from=engine-builder /usr/local/lib/ft8modem /usr/local/lib/ft8modem
COPY --from=engine-builder /usr/local/bin/ft8* /usr/local/bin/
COPY --from=engine-builder /usr/local/bin/af2udp /usr/local/bin/
COPY --from=engine-builder /usr/local/bin/jt9 /usr/local/bin/ft8code /usr/local/bin/ft4code /usr/local/bin/
COPY --from=engine-builder /app/vendor/engine /app/vendor/engine
RUN ldconfig

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=app-builder /app/dist ./dist

ENV NODE_ENV=production
ENV PYTHONPATH=/usr/local/lib/ft8modem
ENV DIGI_DX_CONFIG_PATH=/var/lib/digi-dx/config.json

EXPOSE 8792

CMD ["node", "dist/src/edge/cli.js", "--gui", "--host", "0.0.0.0", "--port", "8792"]
